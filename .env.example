# Copy to .env and fill in. Everything defaults to mock providers, so the system
# runs end to end with no cloud account at all - useful for wiring up the UI,
# load testing the transport, and running CI.

PORT=8080
HOST=0.0.0.0
# PUBLIC_URL=https://listen.dayjoy.in

# Console access. Change both before this is reachable from outside your network.
TRAINER_KEY=dayjoy-trainer
ADMIN_KEY=dayjoy-admin

# Handed to native-speaker reviewers checking the glossary. Keep it separate:
# reviewers are usually not staff and should not hold a key that also opens the
# trainer console.
REVIEW_KEY=dayjoy-review

# The regulatory reviewer signing off health claims. A different person asking a
# different question from the language reviewers, so a different key.
COMPLIANCE_KEY=dayjoy-compliance

# On by default, and it should stay on. A health claim that has not cleared both
# sign-offs is never spoken: the sentence goes out as a caption and the trainer
# is prompted to make the point in their own words.
REQUIRE_CLAIM_SIGNOFF=true

# ---- providers -------------------------------------------------------------
# asr: mock | azure
# mt:  mock | claude | azure
# tts: mock | azure
ASR_PROVIDER=mock
MT_PROVIDER=mock
TTS_PROVIDER=mock

# ---- Azure -----------------------------------------------------------------
# Speech covers both recognition and the neural voices. Central India keeps the
# audio in-country, which is the reason to prefer it over a cheaper region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Azure Translator is used as the fallback whenever the primary translator
# fails or times out. A blunter Telugu sentence beats a silent channel.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# ---- Anthropic (primary translator) ----------------------------------------
# Handles Hinglish, keeps register consistent, and obeys the glossary far more
# reliably than classic machine translation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024

# ---- audio -----------------------------------------------------------------
# 16 kHz / 32 kbps mono MP3 is about 14 MB per hour of continuous speech, which
# lands near 10 MB across a real session once pauses are counted. Switch to
# audio-24khz-48kbitrate-mono-mp3 (and BITRATE 48) for a richer voice at ~21 MB/hr.
AUDIO_FORMAT=audio-16khz-32kbitrate-mono-mp3
AUDIO_BITRATE_KBPS=32

# Per-language voice overrides, if a native speaker prefers the other option.
# VOICE_TE=te-IN-MohanNeural
# VOICE_KN=kn-IN-GaganNeural
# VOICE_OR=or-IN-SukantNeural
# VOICE_BN=bn-IN-BashkarNeural
# VOICE_TA=ta-IN-ValluvarNeural
# VOICE_EN=en-IN-PrabhatNeural

# ---- segmentation ----------------------------------------------------------
# End-silence is the segment-wait line in the latency budget: lower it and
# sentences arrive sooner but get chopped mid-clause.
SEG_END_SILENCE_MS=600
SEG_MIN_WORDS=3
SEG_COALESCE_MS=1200
SEG_MAX_CHARS=320
SEG_MAX_MS=12000

# ---- drift -----------------------------------------------------------------
# Past this backlog a segment is skipped so the channel can resynchronise.
DRIFT_DROP_MS=15000

# Hold translated audio back so it does not arrive before the Zoom video it is
# describing. The trainer sets this per session; this is only the starting value.
ALIGNMENT_DELAY_MS=0

# ---- languages -------------------------------------------------------------
# Off by default: a language nobody is listening to is not translated or spoken,
# which is most of the per-session saving. Turn on to archive every language
# regardless of who attended live.
TRANSLATE_ALL_CHANNELS=false
# ALWAYS_ON_LANGS=te,kn

# ---- recording -------------------------------------------------------------
RECORDING_ENABLED=true
# RECORDING_DIR=./data/recordings
RECORDING_RETENTION_DAYS=365

LOG_LEVEL=info
